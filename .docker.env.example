# BeTor runtime environment — copy to `.docker.env` and fill real values.
# `.docker.env` is gitignored; do NOT commit real secrets.

# MongoDB Atlas (P2P engine database)
DATABASE_MONGO_DB_CONNECTION_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=betor

# Redis (local container)
DATABASE_REDIS_URL=redis://redis:6379/0
BETOR_CELERY_BACKEND_URL=redis://redis:6379/1
BETOR_CELERY_BROKER_URL=redis://redis:6379/1

# Scrapyd / FlareSolverr (local containers)
SCRAPYD_BASE_URL=http://scrapyd:6800
FLARESOLVERR_BASE_URL=http://flaresolverr:8191
FLARESOLVERR_MAX_SESSIONS=1

# Torrent / items storage (served by nginx on port 8001)
STORE_TORRENT_FILE_SAVE_URL=local:///torrents
STORE_TORRENT_FILE_PUBLIC_DOWNLOAD_BASE_URL=http://localhost:8001/torrents
DOWNLOAD_ITEMS_STORE_SAVE_URL=local:///items-data
DOWNLOAD_ITEMS_STORE_PUBLIC_DOWNLOAD_BASE_URL=http://localhost:8001/items-data

# Grafana Cloud InfluxDB (stats collector)
INFLUXDB_STATS_COLLECTOR_HOST=https://prometheus-prod-40-prod-sa-east-1.grafana.net
INFLUXDB_STATS_COLLECTOR_ORG=1917762
INFLUXDB_STATS_COLLECTOR_DATABASE=betor_stats
INFLUXDB_STATS_COLLECTOR_TOKEN=<grafana-cloud-influxdb-write-token>
